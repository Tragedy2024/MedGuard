# 环境变量模板。复制为 .env 后填入真实值：
#
#     cp .env.example .env
#
# ⚠️ .env 含真实密钥，**已被 .gitignore 排除**。绝不要提交它。
#    团队内共享密钥请走群消息 / 密码管理器，不要走仓库。
#    如果误提交了，**必须立刻去服务商后台吊销并换新 Key**——
#    删掉文件是不够的，密钥还留在 git 历史里。

# ── 自然语言 → SQL 的翻译环节 ──────────────────────────────
#
# 只有「未命中缓存的新问法」才需要它。演示路径走的全是缓存（毫秒返回、
# 不依赖网络），所以**没有 Key 也能完整演示**，只是打字问新问题会返回
# 「该问法暂未收录，且未配置模型」。
#
# 注意：这**不是**医盾审计用的模型。审计环节零 LLM、零查库，
# 与本配置无关——那句安全声明不受这里的设置影响。
#
# 后端读取：backend/backend/config.py

OPENAI_API_KEY=sk-在此填入你的密钥
OPENAI_API_BASE=https://api.deepseek.com/v1

# 本地混合 RAG 默认开启；缺依赖、模型或运行失败时自动降级为 BM25。
# 使用 BGE 需要先安装：pip install -r backend/requirements-rag.txt
# CPU 演示推荐 small；有 GPU 或需要多语言时可改为 BAAI/bge-m3。
MEDGUARD_RAG_DENSE=1
MEDGUARD_RAG_DENSE_MODEL=BAAI/bge-small-zh-v1.5
MEDGUARD_RAG_DENSE_MIN_SCORE=0.58
MEDGUARD_RAG_CANDIDATE_K=20
# OpenCMKG 第二知识源（默认关）：把清洗后的 OpenCMKG 检索文档纳入混合召回
# （约 1.5 万条，覆盖大、质量等级低，按来源加权融合；关闭时只检索 YAML 91 条）。
MEDGUARD_RAG_OPENCMKG=0
MEDGUARD_RAG_OPENCMKG_WEIGHT=0.7
MODEL_NAME=deepseek-v4-flash

# ── 平台元数据库（生产推荐 Postgres）──────────────────────────
#
# 不设连接串时用本地 SQLite（backend/data/medguard.db），开发/测试无需任何
# 外部服务。Vercel 部署必须配置：Functions 的文件系统除 /tmp 外只读，
# 而 /tmp 会在冷启动时清空——账号与查询报告只有存进 Postgres 才能保留。
# Vercel Postgres/Neon 创建数据库后会自动注入 POSTGRES_URL；也接受
# DATABASE_URL，或显式覆盖用的 MEDGUARD_DATABASE_URL。
#
# POSTGRES_URL=postgresql://...
#
# ── 以下可选，都有合理默认值，一般不用设 ────────────────────
#
# MEDGUARD_TOKEN_SECRET    令牌 HMAC 签名密钥。**不设也能跑**：有 Postgres
#    时自动生成并存入元数据库（多实例共用，冷启动不掉线）；没有 Postgres
#    时生成并持久化到 backend/data/.token_secret（已 gitignore）。只有在
#    两者都不用时才需要显式指定。
#    改这个值会让所有人当前会话失效（等价于强制重新登录）。
#
# MEDGUARD_DATA_DIR            运行时数据目录（默认 backend/data/；Vercel 自动用
#                              /tmp/medguard）
# MEDGUARD_METADATA_DB         平台元数据库路径
# MEDGUARD_BUSINESS_DB         演示业务库路径
# MEDGUARD_QUERY_CACHE         运行时学习缓存路径（默认 backend/data/query_cache_learned.json，
#                              gitignore；预置演示缓存 demo/query_cache.json 固定只读，不可改）
# MEDGUARD_QUERY_CACHE_LIMIT   每类令牌保留的缓存条数（默认 10）
# MEDGUARD_NL2SQL_SRC          算法层源码目录（默认用内置的 vendor/nl2sql/src）
MEDGUARD_RAG_DENSE_CACHE=1
# 语料向量磁盘缓存（backend/data/dense_*.npy，gitignore）：键=模型名+文档
# 内容哈希，模型或语料一变自动重建；模型已缓存时强制纯离线加载（演示/评测
# 不因网络抖动退化成 BM25）。
#
# 数据源就绪门禁（真实医院数据源建议开 1）：非演示数据源存在未标注表/列时
# 禁止启用与查询（backend/readiness.py）。演示库 regional_health 恒为兼容模式，
# 不受此开关影响。
MEDGUARD_STRICT_DATASOURCES=0
