    "全院各科室的门诊量分别是多少": {
      "plan": [
        {
          "id": 0,
          "description": "查询所有门诊类型的就诊记录对应的科室。",
          "sql": "SELECT `department`\nFROM `visits`\nWHERE `visit_type` = '门诊';"
        },
        {
          "id": 1,
          "description": "按科室统计门诊量。",
          "sql": "SELECT `department`, COUNT(*) AS `门诊量`\nFROM `visits`\nWHERE `visit_type` = '门诊'\nGROUP BY `department`;"
        }
      ],
